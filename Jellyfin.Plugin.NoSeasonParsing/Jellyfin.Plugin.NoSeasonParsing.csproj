<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Match the .NET version and package version of your Jellyfin server (12.0). -->
    <TargetFramework>net9.0</TargetFramework>
    <JellyfinVersion>10.11.*</JellyfinVersion>
    <Nullable>enable</Nullable>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <RootNamespace>Jellyfin.Plugin.NoSeasonParsing</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
